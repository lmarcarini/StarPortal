[gd_resource type="Resource" script_class="StaffNameListDef" format=3]

[ext_resource type="Script" path="res://src/content/staff_name_list_def.gd" id="1_names"]

; docs/content/m26-staff-and-money.md section 1: names that read the same in en and pt_BR.
; M8-01: given names are bound to a sex; the unisex ones go with either.
[resource]
script = ExtResource("1_names")
female_names = Array[String](["Ana", "Lena", "Mira", "Ines", "Sara", "Laura", "Clara", "Sofia", "Julia", "Elena", "Nina", "Marta", "Teresa", "Vera", "Irene"])
male_names = Array[String](["Tom", "Raul", "Kenji", "Dan", "Paulo", "Marco", "Victor", "Hugo", "Daniel", "Igor", "Lucas", "Rafael", "Simon", "Oscar", "Leo"])
unisex_names = Array[String](["Alex", "Sasha", "Kim", "Robin", "Ariel", "Jordan"])
surnames = Array[String](["Ferreira", "Okafor", "Brandt", "Mendes", "Kovacs", "Moreau", "Arai", "Kowalski", "Lind", "Costa", "Novak", "Silva", "Weber", "Rossi", "Tanaka", "Duarte", "Nilsen", "Moreno", "Barros", "Keller", "Lopes", "Ibsen", "Castro", "Varga", "Pereira", "Haas", "Ramos", "Sato", "Lima", "Berg"])
id = &"staff_names"
