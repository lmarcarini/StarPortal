[gd_resource type="Resource" script_class="ConversationDef" format=3]

[ext_resource type="Script" path="res://src/content/conversation_def.gd" id="1"]
[ext_resource type="Script" path="res://src/content/story/conditions/standing_below_condition.gd" id="2"]
[ext_resource type="Script" path="res://src/content/conversation_node_def.gd" id="3"]
[ext_resource type="Script" path="res://src/content/story/effects/offer_request_effect.gd" id="4"]

[sub_resource type="Resource" id="r1"]
script = ExtResource("2")
faction = &"faction_ossar"
amount = -9

[sub_resource type="Resource" id="r2"]
script = ExtResource("3")
id = &"l1"
speaker_key = &"CONV_SPEAKER_OSSAR"
text_key = &"CONV_OSSAR_DEMAND_1"
minutes = 2
next = &"l2"

[sub_resource type="Resource" id="r3"]
script = ExtResource("4")
request = &"request_ossar_closed"

[sub_resource type="Resource" id="r4"]
script = ExtResource("3")
id = &"l2"
speaker_key = &"CONV_SPEAKER_OSSAR"
text_key = &"CONV_OSSAR_DEMAND_2"
minutes = 2
effects = Array[Resource]([SubResource("r3")])
next = &"end"

[sub_resource type="Resource" id="r5"]
script = ExtResource("3")
id = &"end"
kind = 2

[resource]
script = ExtResource("1")
faction = &"faction_ossar"
channels = Array[StringName]([&"incoming"])
conditions = Array[Resource]([SubResource("r1")])
priority = 5
start = &"l1"
nodes = Array[Resource]([SubResource("r2"), SubResource("r4"), SubResource("r5")])
id = &"conv_ossar_demand"
once = true
