[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/archive/document_list.gd" id="1_list"]

[node name="DocumentList" type="VBoxContainer"]
theme_override_constants/separation = 4
script = ExtResource("1_list")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="KindFilter" type="OptionButton" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
auto_translate_mode = 2
clip_text = true

[node name="CountLabel" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
auto_translate_mode = 2

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EmptyLabel" type="Label" parent="Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
auto_translate_mode = 2
autowrap_mode = 3

[node name="Rows" type="VBoxContainer" parent="Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
