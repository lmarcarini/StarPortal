[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/gate_room/console/address_book_panel.gd" id="1_panel"]
[ext_resource type="Script" path="res://src/ui/gate_room/console/glyph_filter.gd" id="2_filter"]

[node name="AddressBookPanel" type="VBoxContainer"]
theme_override_constants/separation = 4
script = ExtResource("1_panel")

[node name="SearchRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="SearchEdit" type="LineEdit" parent="SearchRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "BOOK_SEARCH_PLACEHOLDER"
clear_button_enabled = true

[node name="SourceFilter" type="OptionButton" parent="SearchRow"]
unique_name_in_owner = true
layout_mode = 2
auto_translate_mode = 2
tooltip_text = "BOOK_FILTER_SOURCE_TOOLTIP"

[node name="GlyphFilter" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 2
theme_override_constants/v_separation = 2
columns = 12
script = ExtResource("2_filter")

[node name="CountRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="CountLabel" type="Label" parent="CountRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
auto_translate_mode = 2

[node name="ClearFiltersButton" type="Button" parent="CountRow"]
unique_name_in_owner = true
layout_mode = 2
text = "BOOK_CLEAR_FILTERS"

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EmptyLabel" type="Label" parent="Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
auto_translate_mode = 2
autowrap_mode = 3

[node name="Rows" type="VBoxContainer" parent="Scroll/List"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 2

[node name="NoteRow" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="NoteEdit" type="LineEdit" parent="NoteRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "BOOK_NOTE_PLACEHOLDER"

[node name="SaveNoteButton" type="Button" parent="NoteRow"]
unique_name_in_owner = true
layout_mode = 2
text = "BOOK_SAVE_NOTE"

[node name="LoadButton" type="Button" parent="NoteRow"]
unique_name_in_owner = true
layout_mode = 2
text = "BOOK_LOAD"
