[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/gate_room/console/dial_console.gd" id="1_console"]
[ext_resource type="PackedScene" path="res://src/ui/gate_room/console/seal_row.tscn" id="2_seals"]
[ext_resource type="PackedScene" path="res://src/ui/gate_room/console/glyph_palette.tscn" id="3_palette"]
[ext_resource type="PackedScene" path="res://src/ui/gate_room/dial_controls.tscn" id="4_controls"]

[node name="DialConsole" type="VBoxContainer"]
theme_override_constants/separation = 6
script = ExtResource("1_console")

[node name="SealRow" parent="." instance=ExtResource("2_seals")]
unique_name_in_owner = true
layout_mode = 2

[node name="HintRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Hint" type="Label" parent="HintRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
auto_translate_mode = 2
autowrap_mode = 3

[node name="ClearAllButton" type="Button" parent="HintRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "CONSOLE_CLEAR_ALL"

[node name="Palette" parent="." instance=ExtResource("3_palette")]
unique_name_in_owner = true
layout_mode = 2

[node name="DialControls" parent="." instance=ExtResource("4_controls")]
unique_name_in_owner = true
layout_mode = 2
