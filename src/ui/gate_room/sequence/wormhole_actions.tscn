[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/gate_room/sequence/wormhole_actions.gd" id="1_actions"]
[ext_resource type="PackedScene" path="res://src/ui/gate_room/sequence/console_finds.tscn" id="2_finds"]
[ext_resource type="PackedScene" path="res://src/ui/gate_room/hold_button.tscn" id="3_hold"]

[node name="WormholeActions" type="VBoxContainer"]
theme_override_constants/separation = 6
script = ExtResource("1_actions")

[node name="ActionsTitle" type="Label" parent="."]
layout_mode = 2
text = "GATE_WORMHOLE_ACTIONS"

[node name="PoleCameraButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "GATE_WORMHOLE_EXTEND_CAMERA"

[node name="CameraProgress" type="ProgressBar" parent="."]
unique_name_in_owner = true
visible = false
custom_minimum_size = Vector2(0, 8)
layout_mode = 2
max_value = 5.0
show_percentage = false

[node name="CameraNote" type="Label" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_font_sizes/font_size = 13
autowrap_mode = 3

[node name="PhotoButton" type="Button" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "GATE_WORMHOLE_VIEW_PHOTO"

[node name="ConsoleFinds" parent="." instance=ExtResource("2_finds")]
unique_name_in_owner = true
layout_mode = 2

[node name="ArchiveButton" type="Button" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "GATE_WORMHOLE_READ_ARCHIVE"

[node name="BookButton" type="Button" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "GATE_WORMHOLE_OPEN_BOOK"

[node name="ProbeButton" type="Button" parent="."]
layout_mode = 2
focus_mode = 0
disabled = true
text = "GATE_WORMHOLE_SEND_PROBE"

[node name="ProbeNote" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "GATE_WORMHOLE_PROBES_LATER"
autowrap_mode = 3

[node name="CloseButton" parent="." instance=ExtResource("3_hold")]
unique_name_in_owner = true
layout_mode = 2
text = "GATE_WORMHOLE_CLOSE"
