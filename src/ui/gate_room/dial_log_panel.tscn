[gd_scene format=3]

[ext_resource type="Script" path="res://src/ui/gate_room/dial_log_panel.gd" id="1_panel"]

[node name="DialLogPanel" type="VBoxContainer"]
script = ExtResource("1_panel")

[node name="Heading" type="Label" parent="."]
layout_mode = 2
text = "GATE_LOG_TITLE"

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
layout_mode = 2
text = "GATE_LOG_EMPTY"
autowrap_mode = 3

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
follow_focus = true
horizontal_scroll_mode = 0

[node name="Rows" type="VBoxContainer" parent="Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
